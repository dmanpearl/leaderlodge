# LeaderLodge environment variables
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# .env is listed in .gitignore and must NEVER be committed to version control.

# Required — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-real-secret-key

# Settings module — local.py is the default in manage.py so this is optional locally.
# Set to leaderlodge.settings.production on Railway (Railway dashboard → Variables).
# DJANGO_SETTINGS_MODULE=leaderlodge.settings.local

# Database — leave unset for local SQLite.
#
# Optional override: if you prefer a fixed public URL in .env instead of the
# automatic Railway CLI lookup used by `railway run`, uncomment and set:
# DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:port/railway
#
# load_dotenv(override=True) in base.py lets a .env DATABASE_URL win over the
# private URL that `railway run` injects.

# Postgres service name in Railway (only if yours is not "Postgres"):
# RAILWAY_POSTGRES_SERVICE=Postgres

# Optional extra hostname (e.g. a temporary Railway subdomain during setup).
# DJANGO_ALLOWED_HOST=leaderlodge-production.up.railway.app

# Calendar timezone for game dates and display (default: America/Los_Angeles).
# DJANGO_TIME_ZONE=America/Los_Angeles

# Public read-only demo group browsing (default: true).
# DEMO_MODE_ENABLED=false

# Email (Brevo) - production only; local dev prints mail to the console.
# See docs/setup.md#production-email-brevo
# BREVO_API_KEY=xkeysib-your_api_key_here
# DEFAULT_FROM_EMAIL=LeaderLodge <noreply@leaderlodge.com>
#
# Optional local SMTP testing (not used on Railway when BREVO_API_KEY is set):
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-brevo-login-email@example.com
# EMAIL_HOST_PASSWORD=your_brevo_smtp_key
# EMAIL_USE_TLS=true
